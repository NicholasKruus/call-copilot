// Signing for the iPhone app. Put your own values in Signing.local.xcconfig next to this file (it isn't committed):
//
//   DEVELOPMENT_TEAM = ABCDE12345        // Xcode → Settings → Accounts → your team's ID
//   BUNDLE_ID_PREFIX = com.yourname      // must be unique to you
//
// A free Apple account works for your own iPhone; the app then needs reinstalling every 7 days.
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = com.example
#include? "Signing.local.xcconfig"
